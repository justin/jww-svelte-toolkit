# EditorConfig Info
# https://editorconfig.org/

root = true

[*]
# Unix-style newlines
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_size = 2
indent_style = space
max_line_length = 100

# BBEdit Specific
# https://www.barebones.com/support/technotes/editorconfig.html
x-typographers-quotes: false
x-balance-while-typing: true
x-font-name: "Operator Mono SSm"
x-font-size: 16

[*.go]
indent_style = tab
indent_size = 4
tab_width = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
