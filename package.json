{
  "name": "jww-svelte-toolkit",
  "version": "0.1.0",
  "description": "Shared Svelte theme and UI primitives for Justin's web apps.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    "./theme.css": "./src/lib/theme.css",
    "./utils": {
      "types": "./src/lib/utils.ts",
      "default": "./src/lib/utils.ts"
    },
    "./hooks/*": {
      "types": "./src/lib/hooks/*.ts",
      "svelte": "./src/lib/hooks/*.ts",
      "default": "./src/lib/hooks/*.ts"
    },
    "./mode-toggle.svelte": {
      "types": "./src/lib/components/mode-toggle.svelte",
      "svelte": "./src/lib/components/mode-toggle.svelte"
    },
    "./ui/*": {
      "types": "./src/lib/components/ui/*/index.ts",
      "svelte": "./src/lib/components/ui/*/index.ts",
      "default": "./src/lib/components/ui/*/index.ts"
    }
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/svelte": "^1.64.0",
    "bits-ui": "^2.20.2",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "shadcn-svelte": "^1.7.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.0"
  }
}
